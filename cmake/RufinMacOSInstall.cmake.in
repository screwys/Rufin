include(BundleUtilities)

set(RUFIN_APP "${CMAKE_INSTALL_PREFIX}/@RUFIN_BUNDLE_NAME@.app")
set(RUFIN_CONTENTS "${RUFIN_APP}/Contents")
set(RUFIN_MAIN_EXECUTABLE "${RUFIN_CONTENTS}/MacOS/rufin")

execute_process(
  COMMAND "@RUFIN_MACOS_GLIB_COMPILE_SCHEMAS@"
    "${RUFIN_CONTENTS}/Resources/share/glib-2.0/schemas"
  RESULT_VARIABLE RUFIN_SCHEMA_STATUS
)
if(NOT RUFIN_SCHEMA_STATUS EQUAL 0)
  message(FATAL_ERROR "glib-compile-schemas failed with status ${RUFIN_SCHEMA_STATUS}")
endif()
execute_process(
  COMMAND "@RUFIN_MACOS_GIO_QUERYMODULES@"
    "${RUFIN_CONTENTS}/Resources/lib/gio/modules"
  RESULT_VARIABLE RUFIN_GIO_STATUS
)
if(NOT RUFIN_GIO_STATUS EQUAL 0)
  message(FATAL_ERROR "gio-querymodules failed with status ${RUFIN_GIO_STATUS}")
endif()

file(GLOB_RECURSE RUFIN_BUNDLED_MODULES
  "${RUFIN_CONTENTS}/Resources/lib/gdk-pixbuf-2.0/loaders/*.so"
  "${RUFIN_CONTENTS}/Resources/lib/gio/modules/*.so"
  "${RUFIN_CONTENTS}/Resources/lib/gstreamer-1.0/*.dylib"
)
fixup_bundle(
  "${RUFIN_APP}"
  "${RUFIN_BUNDLED_MODULES}"
  "@RUFIN_MACOS_BREW_PREFIX@/lib"
)

execute_process(
  COMMAND /usr/bin/otool -l "${RUFIN_MAIN_EXECUTABLE}"
  OUTPUT_VARIABLE RUFIN_MAIN_LOAD_COMMANDS
  RESULT_VARIABLE RUFIN_OTOOL_STATUS
)
if(NOT RUFIN_OTOOL_STATUS EQUAL 0)
  message(FATAL_ERROR "otool failed for ${RUFIN_MAIN_EXECUTABLE}")
endif()
if(NOT RUFIN_MAIN_LOAD_COMMANDS MATCHES "path /usr/lib/swift ")
  execute_process(
    COMMAND "@RUFIN_MACOS_INSTALL_NAME_TOOL@" -add_rpath /usr/lib/swift
      "${RUFIN_MAIN_EXECUTABLE}"
    COMMAND_ERROR_IS_FATAL ANY
  )
endif()

file(GLOB_RECURSE RUFIN_BUNDLE_FILES "${RUFIN_CONTENTS}/*")
foreach(RUFIN_BUNDLE_FILE IN LISTS RUFIN_BUNDLE_FILES)
  if(IS_DIRECTORY "${RUFIN_BUNDLE_FILE}")
    continue()
  endif()
  execute_process(
    COMMAND "@RUFIN_MACOS_FILE@" "${RUFIN_BUNDLE_FILE}"
    OUTPUT_VARIABLE RUFIN_FILE_TYPE
    RESULT_VARIABLE RUFIN_FILE_STATUS
  )
  if(NOT RUFIN_FILE_STATUS EQUAL 0 OR NOT RUFIN_FILE_TYPE MATCHES "Mach-O")
    continue()
  endif()

  execute_process(
    COMMAND "@RUFIN_MACOS_LIPO@" -archs "${RUFIN_BUNDLE_FILE}"
    OUTPUT_VARIABLE RUFIN_ARCHITECTURES
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY
  )
  if(NOT RUFIN_ARCHITECTURES STREQUAL "@CMAKE_SYSTEM_PROCESSOR@")
    set(RUFIN_THIN_FILE "${RUFIN_BUNDLE_FILE}.rufin-thin")
    execute_process(
      COMMAND "@RUFIN_MACOS_LIPO@" "${RUFIN_BUNDLE_FILE}"
        -thin "@CMAKE_SYSTEM_PROCESSOR@" -output "${RUFIN_THIN_FILE}"
      COMMAND_ERROR_IS_FATAL ANY
    )
    file(CHMOD "${RUFIN_THIN_FILE}"
      PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    file(RENAME "${RUFIN_THIN_FILE}" "${RUFIN_BUNDLE_FILE}")
  endif()

  if(NOT RUFIN_BUNDLE_FILE STREQUAL RUFIN_MAIN_EXECUTABLE)
    set(RUFIN_SIGN_COMMAND
      "@RUFIN_MACOS_CODESIGN@" --force --sign "@RUFIN_MACOS_SIGN_IDENTITY@")
    if(NOT "@RUFIN_MACOS_SIGN_KEYCHAIN@" STREQUAL "")
      list(APPEND RUFIN_SIGN_COMMAND --keychain "@RUFIN_MACOS_SIGN_KEYCHAIN@")
    endif()
    list(APPEND RUFIN_SIGN_COMMAND "${RUFIN_BUNDLE_FILE}")
    execute_process(COMMAND ${RUFIN_SIGN_COMMAND} COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()

set(RUFIN_APP_SIGN_COMMAND
  "@RUFIN_MACOS_CODESIGN@" --force --sign "@RUFIN_MACOS_SIGN_IDENTITY@")
if(NOT "@RUFIN_MACOS_SIGN_KEYCHAIN@" STREQUAL "")
  list(APPEND RUFIN_APP_SIGN_COMMAND --keychain "@RUFIN_MACOS_SIGN_KEYCHAIN@")
endif()
list(APPEND RUFIN_APP_SIGN_COMMAND --identifier "@RUFIN_APP_ID@" "${RUFIN_APP}")
execute_process(COMMAND ${RUFIN_APP_SIGN_COMMAND} COMMAND_ERROR_IS_FATAL ANY)
execute_process(
  COMMAND "@RUFIN_MACOS_CODESIGN@" --verify --deep --strict "${RUFIN_APP}"
  COMMAND_ERROR_IS_FATAL ANY
)
verify_app("${RUFIN_APP}")
