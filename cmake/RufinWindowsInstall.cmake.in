set(RUFIN_INSTALL_ROOT "${CMAKE_INSTALL_PREFIX}")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@RUFIN_WINDOWS_OBJDUMP@")
file(GLOB_RECURSE RUFIN_RUNTIME_EXECUTABLES
  "${RUFIN_INSTALL_ROOT}/*.exe")
file(GLOB_RECURSE RUFIN_RUNTIME_LIBRARIES
  "${RUFIN_INSTALL_ROOT}/*.dll")

file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES ${RUFIN_RUNTIME_EXECUTABLES}
  LIBRARIES ${RUFIN_RUNTIME_LIBRARIES}
  DIRECTORIES @RUFIN_WINDOWS_RUNTIME_DIRS@
  PRE_EXCLUDE_REGEXES "api-ms-win-.*" "ext-ms-win-.*"
  POST_EXCLUDE_REGEXES ".*[\\/]Windows[\\/]System32[\\/].*"
  RESOLVED_DEPENDENCIES_VAR RUFIN_RESOLVED_DEPENDENCIES
  UNRESOLVED_DEPENDENCIES_VAR RUFIN_UNRESOLVED_DEPENDENCIES
  CONFLICTING_DEPENDENCIES_PREFIX RUFIN_CONFLICTING_DEPENDENCIES
)
if(RUFIN_UNRESOLVED_DEPENDENCIES)
  list(JOIN RUFIN_UNRESOLVED_DEPENDENCIES ", " RUFIN_UNRESOLVED_TEXT)
  message(FATAL_ERROR "Unresolved Windows runtime dependencies: ${RUFIN_UNRESOLVED_TEXT}")
endif()
if(RUFIN_CONFLICTING_DEPENDENCIES_FILENAMES)
  list(JOIN RUFIN_CONFLICTING_DEPENDENCIES_FILENAMES ", " RUFIN_CONFLICTING_TEXT)
  message(FATAL_ERROR "Conflicting Windows runtime dependencies: ${RUFIN_CONFLICTING_TEXT}")
endif()
file(INSTALL
  DESTINATION "${RUFIN_INSTALL_ROOT}/bin"
  TYPE SHARED_LIBRARY
  FOLLOW_SYMLINK_CHAIN
  FILES ${RUFIN_RESOLVED_DEPENDENCIES}
)

execute_process(
  COMMAND "@RUFIN_WINDOWS_SCHEMA_COMMAND@"
    "${RUFIN_INSTALL_ROOT}/share/glib-2.0/schemas"
  RESULT_VARIABLE RUFIN_SCHEMA_STATUS
)
if(NOT RUFIN_SCHEMA_STATUS EQUAL 0)
  message(FATAL_ERROR "glib-compile-schemas failed with status ${RUFIN_SCHEMA_STATUS}")
endif()

file(REMOVE "${RUFIN_INSTALL_ROOT}/share/icons/hicolor/icon-theme.cache")
execute_process(
  COMMAND "@RUFIN_WINDOWS_ICON_COMMAND@" -q -t -f
    "${RUFIN_INSTALL_ROOT}/share/icons/hicolor"
  RESULT_VARIABLE RUFIN_ICON_STATUS
)
if(NOT RUFIN_ICON_STATUS EQUAL 0)
  message(FATAL_ERROR "gtk4-update-icon-cache failed with status ${RUFIN_ICON_STATUS}")
endif()
