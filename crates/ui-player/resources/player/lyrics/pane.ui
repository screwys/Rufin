<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>

  <object class="GtkOverlay" id="root">
    <property name="vexpand">true</property>
    <property name="margin-end">0</property>
    <style><class name="lyrics-panel"/></style>
    <property name="child">
      <object class="GtkScrolledWindow" id="scroller">
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="child">
          <object class="GtkBox" id="body">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="vexpand">true</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <style><class name="lyrics-lines"/></style>
          </object>
        </property>
      </object>
    </property>
    <child type="overlay">
      <object class="GtkBox" id="top_controls">
        <property name="orientation">horizontal</property>
        <property name="spacing">2</property>
        <property name="halign">start</property>
        <property name="valign">start</property>
        <property name="margin-start">8</property>
        <style><class name="lyrics-controls"/><class name="lyrics-top-controls"/></style>
        <child><object class="GtkButton" id="search_button"><property name="icon-name">rufin-lyrics-search-symbolic</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
        <child><object class="GtkButton" id="settings_button"><property name="icon-name">rufin-applications-system-symbolic</property><property name="focus-on-click">false</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
        <child><object class="GtkButton" id="edit_button"><property name="icon-name">rufin-document-edit-symbolic</property><property name="focus-on-click">false</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
      </object>
    </child>
    <child type="overlay">
      <object class="GtkBox" id="controls">
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>
        <property name="halign">center</property>
        <property name="valign">end</property>
        <property name="margin-bottom">10</property>
        <style><class name="lyrics-controls"/><class name="lyrics-control-bar"/></style>
        <child><object class="GtkButton" id="save_button"><property name="icon-name">rufin-download-symbolic</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
        <child><object class="GtkButton" id="offset_decrease_button"><property name="icon-name">rufin-value-decrease-symbolic</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
        <child><object class="GtkEntry" id="offset_entry"><property name="text">0 ms</property><property name="xalign">0.5</property><property name="width-chars">4</property><property name="max-width-chars">8</property><property name="max-length">24</property><style><class name="flat"/><class name="lyrics-offset-value"/></style></object></child>
        <child><object class="GtkButton" id="offset_increase_button"><property name="icon-name">rufin-list-add-symbolic</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
        <child><object class="GtkButton" id="clear_auto_search_button"><property name="icon-name">rufin-process-stop-symbolic</property><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
      </object>
    </child>
  </object>
</interface>
