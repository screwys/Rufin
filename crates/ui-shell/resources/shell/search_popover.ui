<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <object class="GtkPopover" id="popover">
    <style><class name="search-popover"/></style>
    <property name="position">bottom</property>
    <property name="has-arrow">false</property>
    <property name="autohide">false</property>
    <property name="child"><object class="GtkBox">
      <property name="orientation">vertical</property><property name="spacing">6</property>
      <child><object class="GtkLabel" id="error"><property name="label" translatable="yes">Search unavailable</property><property name="margin-top">8</property><property name="margin-bottom">8</property><property name="visible">false</property><style><class name="dim-label"/></style></object></child>
      <child><object class="GtkLabel" id="empty_results"><property name="ellipsize">end</property><property name="max-width-chars">40</property><property name="margin-top">8</property><property name="margin-bottom">8</property><property name="visible">false</property><style><class name="dim-label"/></style></object></child>
      <child><object class="GtkScrolledWindow" id="scroller">
        <property name="hscrollbar-policy">external</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="overlay-scrolling">true</property>
        <style><class name="search-scroller"/></style>
        <property name="propagate-natural-width">false</property>
        <property name="propagate-natural-height">true</property>
        <property name="max-content-height">420</property>
        <property name="child"><object class="GtkListBox" id="list">
          <property name="selection-mode">single</property>
          <property name="activate-on-single-click">true</property>
          <property name="focusable">false</property>
          <style><class name="search-results"/></style>
        </object></property>
      </object></child>
    </object></property>
  </object>
  <object class="GtkListBoxRow" id="history_heading">
    <property name="selectable">false</property><property name="activatable">false</property><property name="focusable">false</property>
    <property name="child"><object class="GtkBox">
      <child><object class="GtkLabel"><property name="label" translatable="yes">Recent searches</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="heading"/></style></object></child>
    </object></property>
  </object>
  <object class="GtkListBoxRow" id="history_footer">
    <property name="selectable">false</property><property name="activatable">false</property><property name="focusable">false</property>
    <property name="child"><object class="GtkButton" id="clear_history">
      <property name="label" translatable="yes">Clear</property>
      <property name="halign">start</property><property name="focus-on-click">false</property>
      <style><class name="search-clear"/></style>
    </object></property>
  </object>
  <object class="GtkListBoxRow" id="tracks_heading">
    <property name="focusable">false</property><property name="selectable">false</property><property name="activatable">false</property>
    <property name="child"><object class="GtkBox">
      <property name="spacing">12</property>
      <child><object class="GtkLabel"><property name="label" translatable="yes">Tracks</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="heading"/></style></object></child>
      <child><object class="GtkButton" id="tracks_more">
        <property name="label" translatable="yes">View all</property>
        <property name="focus-on-click">false</property>
        <style><class name="flat"/><class name="search-category-link"/></style>
      </object></child>
    </object></property>
  </object>
  <object class="GtkListBoxRow" id="albums_heading">
    <property name="focusable">false</property><property name="selectable">false</property><property name="activatable">false</property>
    <property name="child"><object class="GtkBox">
      <property name="spacing">12</property>
      <child><object class="GtkLabel"><property name="label" translatable="yes">Albums</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="heading"/></style></object></child>
      <child><object class="GtkButton" id="albums_more">
        <property name="label" translatable="yes">View all</property>
        <property name="focus-on-click">false</property>
        <style><class name="flat"/><class name="search-category-link"/></style>
      </object></child>
    </object></property>
  </object>
  <object class="GtkListBoxRow" id="artists_heading">
    <property name="focusable">false</property><property name="selectable">false</property><property name="activatable">false</property>
    <property name="child"><object class="GtkBox">
      <property name="spacing">12</property>
      <child><object class="GtkLabel"><property name="label" translatable="yes">Artists</property><property name="xalign">0</property><property name="hexpand">true</property><style><class name="heading"/></style></object></child>
      <child><object class="GtkButton" id="artists_more">
        <property name="label" translatable="yes">View all</property>
        <property name="focus-on-click">false</property>
        <style><class name="flat"/><class name="search-category-link"/></style>
      </object></child>
    </object></property>
  </object>
</interface>
