<?xml version="1.0" ?>
<interface domain="rufin">
  <object class="GtkFileDialog" id="export_dialog">
    <property name="title" translatable="yes">Export PNG</property>
  </object>
  <object class="GtkPopover" id="settings_popover">
    <property name="child">
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Customize display</property>
        <child>
          <object class="AdwSwitchRow" id="dynamic_background">
            <property name="title" translatable="yes">Dynamic background</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="background_image">
            <property name="title" translatable="yes">Enable background image</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="show_tracks">
            <property name="title" translatable="yes">Top tracks</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="show_artists">
            <property name="title" translatable="yes">Top artists</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="show_albums">
            <property name="title" translatable="yes">Top albums</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="show_genres">
            <property name="title" translatable="yes">Top genres</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="show_comparison">
            <property name="title" translatable="yes">Show comparison</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="show_rufin_in_headline">
            <property name="title" translatable="yes">Show Rufin in headline</property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Results per section</property>
            <property name="activatable-widget">result_count</property>
            <child type="suffix">
              <object class="GtkDropDown" id="result_count">
                <property name="valign">center</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>3</item>
                      <item>5</item>
                      <item>10</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkBox" id="root">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style>
      <class name="activity-overview"/>
    </style>
    <child>
      <object class="AdwWrapBox" id="toolbar">
        <property name="child-spacing">4</property>
        <property name="line-spacing">4</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-top">2</property>
        <property name="margin-bottom">2</property>
        <child>
          <object class="GtkButton" id="minimize">
            <property name="icon-name">rufin-go-down-symbolic</property>
            <property name="tooltip-text" translatable="yes">Minimize overview</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkMenuButton" id="customize">
            <property name="icon-name">rufin-sliders-2-symbolic</property>
            <property name="tooltip-text" translatable="yes">Customize display</property>
            <property name="popover">settings_popover</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">4</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkDropDown" id="period_kind">
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Month</item>
                      <item translatable="yes">Year</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <style>
                  <class name="linked"/>
                </style>
                <child>
                  <object class="GtkButton" id="previous">
                    <property name="icon-name">rufin-go-previous-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Previous period</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="period"/>
                </child>
                <child>
                  <object class="GtkButton" id="next">
                    <property name="icon-name">rufin-go-next-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Next period</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="export">
            <style>
              <class name="flat"/>
            </style>
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">image-x-generic-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Export PNG</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="status">
        <property name="label" translatable="yes">Loading…</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="scroll">
        <property name="hscrollbar-policy">never</property>
        <property name="vexpand">true</property>
        <property name="child">
          <object class="GtkViewport">
            <property name="scroll-to-focus">true</property>
            <property name="child">
              <object class="AdwBin" id="report_host"/>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
  <object class="GtkOverlay" id="report">
    <property name="hexpand">true</property>
    <style>
      <class name="activity-report"/>
    </style>
    <property name="child">
      <object class="AdwClamp" id="content_clamp">
        <property name="maximum-size">1200</property>
        <property name="tightening-threshold">1000</property>
        <property name="child">
          <object class="GtkBox" id="content">
            <property name="orientation">vertical</property>
            <property name="spacing">28</property>
            <property name="margin-start">28</property>
            <property name="margin-end">28</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">32</property>
            <child>
              <object class="GtkBox" id="heading_row">
                <property name="spacing">28</property>
                <property name="homogeneous">true</property>
                <child>
                  <object class="GtkLabel" id="title">
                    <property name="wrap">true</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0.5</property>
                    <property name="hexpand">true</property>
                    <style>
                      <class name="activity-title"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkBox">
                        <property name="homogeneous">true</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="activity-stat"/>
                            </style>
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-history-symbolic</property>
                                    <style>
                                      <class name="activity-stat-icon"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Hours</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkLabel" id="hours_value">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="activity-total"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="hours_change">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="caption"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="activity-stat"/>
                            </style>
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-media-playback-start-symbolic</property>
                                    <style>
                                      <class name="activity-stat-icon"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Plays</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkLabel" id="plays_value">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="activity-total"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="plays_change">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="caption"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="homogeneous">true</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="activity-stat"/>
                            </style>
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-artists-symbolic</property>
                                    <style>
                                      <class name="activity-stat-icon"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Artists</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkLabel" id="artists_value">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="activity-total"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="artists_change">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="caption"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="activity-stat"/>
                            </style>
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-tracks-symbolic</property>
                                    <style>
                                      <class name="activity-stat-icon"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Tracks</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkLabel" id="tracks_value">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="activity-total"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="tracks_change">
                                    <property name="xalign">0</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="caption"/>
                                    </style>
                                    <property name="valign">baseline</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="artwork_row">
                <property name="spacing">24</property>
                <property name="homogeneous">true</property>
                <child>
                  <object class="GtkBox" id="artists_section">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top artists</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="title-2"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="artists_host">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="albums_section">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top albums</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="title-2"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="albums_host">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator"/>
            </child>
            <child>
              <object class="GtkBox" id="ranking_row">
                <property name="spacing">24</property>
                <property name="homogeneous">true</property>
                <child>
                  <object class="GtkBox" id="tracks_section">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top tracks</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="title-2"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="tracks_host">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="genres_section">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Top genres</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="title-2"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="genres_host">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="GtkLabel" id="empty_text">
    <property name="label" translatable="yes">No listening activity in this period</property>
  </object>
  <object class="GtkLabel" id="error_text">
    <property name="label" translatable="yes">Could not load listening overview</property>
  </object>
</interface>
