<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <object class="GtkBox" id="window_content">
    <property name="orientation">vertical</property>
    <child><object class="GtkHeaderBar" id="header">
    <property name="show-title-buttons">true</property>
    <style><class name="shared-topbar"/></style>
    <child type="start"><object class="GtkBox" id="navigation">
      <property name="spacing">2</property>
      <child><object class="GtkButton" id="sidebar">
        <property name="icon-name">rufin-sidebar-show-symbolic</property>
        <property name="tooltip-text" translatable="yes">Show sidebar</property>
        <accessibility><property name="label" translatable="yes">Show sidebar</property></accessibility>
        <style><class name="flat"/><class name="topbar-button"/></style>
      </object></child>
      <child><object class="GtkButton" id="back">
        <property name="icon-name">rufin-go-previous-symbolic</property>
        <property name="action-name">win.go-back</property>
        <property name="tooltip-text" translatable="yes">Back</property>
        <accessibility><property name="label" translatable="yes">Back</property></accessibility>
        <style><class name="flat"/><class name="topbar-button"/></style>
      </object></child>
      <child><object class="GtkButton" id="forward">
        <property name="icon-name">rufin-go-next-symbolic</property>
        <property name="action-name">win.go-forward</property>
        <property name="tooltip-text" translatable="yes">Forward</property>
        <accessibility><property name="label" translatable="yes">Forward</property></accessibility>
        <style><class name="flat"/><class name="topbar-button"/></style>
      </object></child>
      <child><object class="GtkMenuButton" id="controller">
        <property name="icon-name">rufin-phonelink-symbolic</property>
        <property name="tooltip-text" translatable="yes">Controller</property>
        <accessibility><property name="label" translatable="yes">Controller</property></accessibility>
        <style><class name="flat"/><class name="topbar-button"/></style>
      </object></child>
      <child><object class="GtkBox" id="casting_host"/></child>
    </object></child>
    <property name="title-widget"><object class="GtkSearchEntry" id="search">
      <property name="hexpand">false</property>
      <property name="halign">center</property>
      <property name="width-request">1</property>
      <property name="width-chars">1</property>
      <property name="max-width-chars">28</property>
      <property name="placeholder-text" translatable="yes">Search</property>
      <accessibility><property name="label" translatable="yes">Search</property></accessibility>
    </object></property>
    <child type="end"><object class="GtkBox">
      <property name="spacing">2</property>
      <child><object class="GtkMenuButton" id="source">
        <property name="icon-name">rufin-library-symbolic</property>
        <property name="tooltip-text" translatable="yes">Select Source</property>
        <accessibility><property name="label" translatable="yes">Select Source</property></accessibility>
        <style><class name="flat"/><class name="topbar-button"/></style>
      </object></child>
      <child><object class="GtkMenuButton" id="menu">
        <property name="icon-name">rufin-open-menu-symbolic</property>
        <property name="tooltip-text" translatable="yes">Menu</property>
        <accessibility><property name="label" translatable="yes">Menu</property></accessibility>
        <style><class name="flat"/><class name="topbar-button"/></style>
      </object></child>
    </object></child>
    </object></child>
    <child><object class="AdwBin" id="content_host"><property name="vexpand">true</property></object></child>
  </object>
</interface>
