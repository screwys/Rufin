<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="GtkBox" id="normal_nav_panel">
    <property name="overflow">hidden</property>
    <property name="margin-end">8</property>
    <property name="orientation">vertical</property>
    <property name="width-request">1</property>
    <property name="vexpand">true</property>
    <style>
      <class name="sidebar-pane" />
      <class name="wide-sidebar-slot" />
    </style>
    <child>
      <object class="GtkScrolledWindow" id="normal_nav_scroller">
        <style>
          <class name="sidebar-scroller" />
        </style>
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="width-request">1</property>
        <property name="min-content-width">1</property>
        <property name="max-content-width">-1</property>
        <property name="propagate-natural-width">false</property>
        <property name="propagate-natural-height">false</property>
        <property name="hexpand">false</property>
        <property name="vexpand">true</property>
        <property name="child">
          <object class="GtkViewport">
            <property name="vscroll-policy">natural</property>
            <property name="child">
              <object class="GtkBox" id="normal_nav">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="width-request">1</property>
                <style>
                  <class name="wide-sidebar" />
                </style>
                <child>
                  <object class="AdwSidebar" id="normal_nav_routes">
                    <property name="mode">sidebar</property>
                    <property name="vexpand">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="normal_nav_pins">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <property name="vexpand">false</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
  <object class="GtkBox" id="compact_nav_slot">
    <property name="overflow">hidden</property>
    <property name="margin-end">8</property>
    <property name="orientation">vertical</property>
    <property name="vexpand">true</property>
    <style>
      <class name="sidebar-pane" />
      <class name="compact-rail-slot" />
    </style>
    <child>
      <object class="GtkScrolledWindow" id="compact_nav_scroller">
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="propagate-natural-width">false</property>
        <property name="propagate-natural-height">false</property>
        <property name="hexpand">false</property>
        <property name="vexpand">true</property>
        <style>
          <class name="sidebar-scroller" />
        </style>
        <property name="child">
          <object class="GtkViewport">
            <property name="vscroll-policy">natural</property>
            <property name="child">
              <object class="GtkBox" id="compact_nav">
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <property name="hexpand">false</property>
                <property name="vexpand">true</property>
                <style>
                  <class name="compact-rail" />
                </style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
  <object class="GtkStack" id="sidebar_modes">
    <property name="hhomogeneous">false</property>
    <property name="vhomogeneous">true</property>
    <property name="overflow">hidden</property>
  </object>
</interface>
