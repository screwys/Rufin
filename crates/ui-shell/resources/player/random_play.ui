<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="AdwDialog" id="random_play_dialog">
    <property name="content-width">460</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="dialog_title">
                <property name="title" translatable="yes">Play random</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">14</property>
            <property name="margin-top">18</property>
            <property name="margin-bottom">18</property>
            <property name="margin-start">18</property>
            <property name="margin-end">18</property>

            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="limit_label">
                    <property name="label" translatable="yes">Number of songs</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="limit">
                    <property name="numeric">true</property>
                    <property name="width-chars">5</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="min_year_label">
                    <property name="label" translatable="yes">Minimum year</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="min_year_enabled"/>
                </child>
                <child>
                  <object class="GtkSpinButton" id="min_year">
                    <property name="numeric">true</property>
                    <property name="width-chars">5</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="max_year_label">
                    <property name="label" translatable="yes">Maximum year</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="max_year_enabled"/>
                </child>
                <child>
                  <object class="GtkSpinButton" id="max_year">
                    <property name="numeric">true</property>
                    <property name="width-chars">5</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="genre_label">
                    <property name="label" translatable="yes">Genre</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="genre">
                    <property name="enable-search">true</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="played_filter_label">
                    <property name="label" translatable="yes">Play filter</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="played_filter"/>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="spacing">8</property>
                <property name="halign">end</property>
                <child>
                  <object class="GtkButton" id="play_next">
                    <style>
                      <class name="pill-button"/>
                      <class name="pill"/>
                    </style>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">rufin-mail-forward-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="play_next_label">
                            <property name="label" translatable="yes">Play Next</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="play_now">
                    <style>
                      <class name="pill-button"/>
                      <class name="pill"/>
                      <class name="suggested-action"/>
                    </style>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">rufin-media-playback-start-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="play_now_label">
                            <property name="label" translatable="yes">Play</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="play_later">
                    <style>
                      <class name="pill-button"/>
                      <class name="pill"/>
                    </style>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">rufin-go-last-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="play_later_label">
                            <property name="label" translatable="yes">Play Later</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
