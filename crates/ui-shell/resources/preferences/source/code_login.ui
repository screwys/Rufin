<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>
  <object class="AdwDialog" id="dialog">
    <property name="title" translatable="yes">Sign in with a code</property>
    <property name="content-width">360</property>
    <property name="child"><object class="AdwToolbarView">
      <child type="top"><object class="AdwHeaderBar"/></child>
      <property name="content"><object class="GtkBox">
        <property name="orientation">vertical</property><property name="spacing">18</property>
        <property name="margin-start">24</property><property name="margin-end">24</property><property name="margin-top">12</property><property name="margin-bottom">12</property>
        <child><object class="GtkLabel"><property name="label" translatable="yes">Approve sign-in in your browser</property><property name="wrap">true</property></object></child>
        <child><object class="GtkBox" id="code_row">
          <property name="visible">false</property>
          <property name="spacing">12</property><property name="halign">center</property>
          <child><object class="GtkLabel" id="code"><property name="selectable">true</property><property name="wrap">true</property><property name="valign">center</property><style><class name="title-1"/></style></object></child>
          <child><object class="GtkButton" id="copy">
            <property name="child"><object class="GtkImage" id="copy_icon"><property name="icon-name">rufin-edit-copy-symbolic</property><property name="pixel-size">24</property></object></property>
            <property name="tooltip-text" translatable="yes">Copy</property>
            <property name="valign">center</property><property name="sensitive">false</property>
            <accessibility><property name="label" translatable="yes">Copy</property></accessibility>
            <style><class name="flat"/><class name="circular"/></style>
          </object></child>
        </object></child>
        <child><object class="GtkLinkButton" id="approval"><property name="label" translatable="yes">Open approval page</property><property name="sensitive">false</property><property name="halign">center</property></object></child>
        <child><object class="GtkButton" id="refresh"><property name="label" translatable="yes">Refresh</property><property name="halign">center</property></object></child>
        <child><object class="GtkLabel" id="status"><property name="wrap">true</property><property name="visible">false</property></object></child>
      </object></property>
    </object></property>
  </object>
</interface>
