<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="AdwPreferencesPage" id="page">
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">rufin-preferences-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Language</property>
        <child>
          <object class="AdwComboRow" id="language_row">
            <property name="title" translatable="yes">Language</property>
            <property name="subtitle" translatable="yes">Changes take effect after restarting Rufin</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="window_group">
        <property name="title" translatable="yes">App settings</property>
        <child>
          <object class="AdwComboRow" id="starting_page_row">
            <property name="title" translatable="yes">Starting page</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="tray_row">
            <property name="title" translatable="yes">Show tray icon</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="keep_running_row">
            <property name="title" translatable="yes">Keep Rufin running after closing the window</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="start_minimized_row">
            <property name="title" translatable="yes">Start minimized</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="type_to_search_row">
            <property name="title" translatable="yes">Type to search</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="automatic_updates_row">
            <property name="title" translatable="yes">Automatic updates</property>
            <property name="subtitle" translatable="yes">Install available updates when Rufin starts</property>
          </object>
        </child>
        <child>
          <object class="AdwComboRow" id="release_check_interval_row">
            <property name="title" translatable="yes">Update check interval</property>
            <property name="model">
              <object class="GtkStringList">
                <items>
                  <item translatable="yes">1 hour</item>
                  <item translatable="yes">6 hours</item>
                  <item translatable="yes">12 hours</item>
                  <item translatable="yes">24 hours</item>
                </items>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="activity_overview_row">
            <property name="title" translatable="yes">Listening overview</property>
            <property name="activatable">true</property>
            <child type="suffix">
              <object class="GtkImage">
                <property name="icon-name">rufin-go-next-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Metadata</property>
        <child>
          <object class="AdwSwitchRow" id="prefer_distinct_track_covers_row">
            <property name="title" translatable="yes">Prefer distinct track covers</property>
            <property name="subtitle" translatable="yes">Use each track's own cover when available</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="external_metadata_row">
            <property name="title" translatable="yes">External metadata lookup</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="external_lyrics_row">
            <property name="title" translatable="yes">External lyrics lookup</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Notifications</property>
        <child>
          <object class="AdwSwitchRow" id="control_notifications_row">
            <property name="title" translatable="yes">Control notifications</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="notifications_row">
            <property name="title" translatable="yes">Now playing notifications</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="release_notifications_row">
            <property name="title" translatable="yes">Release notifications</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
