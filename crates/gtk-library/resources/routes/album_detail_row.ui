<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <object class="GtkBox" id="root">
    <property name="hexpand">true</property>
    <property name="accessible-role">presentation</property>
    <style><class name="album-detail-row"/></style>
    <child>
      <object class="GtkBox" id="gap">
        <property name="margin-start">12</property>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="content">
        <property name="hexpand">true</property>
        <property name="margin-end">12</property>
        <property name="hhomogeneous">false</property>
        <property name="vhomogeneous">true</property>
        <property name="transition-type">none</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">header</property>
            <property name="child"><object class="GtkBox" id="header"/></property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">track</property>
            <property name="child"><object class="GtkBox" id="track"/></property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">blank</property>
            <property name="child"><object class="GtkBox"/></property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
