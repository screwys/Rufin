<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="AdwDialog" id="dialog">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="title">
                <property name="title" translatable="yes">Customize display</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow" id="scroller">
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <property name="margin-top">18</property>
                <property name="margin-bottom">18</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <child>
                  <object class="AdwPreferencesGroup" id="layout_group">
                    <property name="title" translatable="yes">Layout</property>
                    <property name="header-suffix">
                      <object class="GtkButton" id="reset">
                        <property name="label" translatable="yes">Reset</property>
                        <property name="tooltip-text" translatable="yes">Reset to defaults</property>
                        <property name="valign">end</property>
                        <property name="margin-end">16</property>
                        <style><class name="destructive-action"/></style>
                      </object>
                    </property>
                    <child>
                      <object class="AdwActionRow" id="layout_row">
                        <property name="title" translatable="yes">View</property>
                        <child type="suffix">
                          <object class="GtkBox" id="layout_box">
                            <property name="orientation">horizontal</property>
                            <property name="valign">center</property>
                            <style><class name="linked"/><class name="preference-selection-buttons"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child><object class="AdwPreferencesGroup" id="fields_group"/></child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
