<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="GtkOverlay" id="root">
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <property name="visible">false</property>
    <property name="can-target">false</property>
    <property name="sensitive">false</property>
    <property name="opacity">0</property>
    <style>
      <class name="fullscreen-player" />
    </style>
    <property name="child">
      <object class="GtkBox" id="body">
        <property name="orientation">vertical</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox" id="topbar">
            <property name="spacing">2</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <property name="margin-top">2</property>
            <property name="margin-bottom">2</property>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="icon-name">rufin-go-down-symbolic</property>
                <property name="tooltip-text" translatable="yes">Close fullscreen player</property>
                <style>
                  <class name="flat" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="customize_button">
                <property name="icon-name">rufin-sliders-2-symbolic</property>
                <property name="tooltip-text" translatable="yes">Customize display</property>
                <style>
                  <class name="flat" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pane_button">
                <property name="icon-name">rufin-view-dual-symbolic</property>
                <property name="tooltip-text" translatable="yes">Switch pane</property>
                <style>
                  <class name="flat" />
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="panes">
            <property name="homogeneous">true</property>
            <property name="spacing">8</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <property name="margin-bottom">8</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkBox" id="left_pane">
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkBox" id="hero">
                    <property name="orientation">vertical</property>
                    <property name="overflow">hidden</property>
                    <property name="hexpand">true</property>
                    <style>
                      <class name="fullscreen-player-hero" />
                      <class name="wide-sidebar-slot" />
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkOverlay" id="experience">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <style>
                      <class name="wide-sidebar-slot" />
                      <class name="fullscreen-player-experience" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="right_pane">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">true</property>
                <style>
                  <class name="wide-sidebar-slot" />
                  <class name="fullscreen-player-tabs" />
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="halign">center</property>
                    <style>
                      <class name="linked" />
                    </style>
                    <child>
                      <object class="GtkToggleButton" id="queue_tab">
                        <property name="tooltip-text" translatable="yes">Queue</property>
                        <property name="active">true</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">rufin-queue-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Queue</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton" id="related_tab">
                        <property name="tooltip-text" translatable="yes">Related</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">rufin-compass-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Related</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton" id="equalizer_tab">
                        <property name="tooltip-text" translatable="yes">Equalizer</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">rufin-sliders-vertical-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Equalizer</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStack" id="stack">
                    <property name="hhomogeneous">false</property>
                    <property name="vhomogeneous">false</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                  </object>
                </child>
                <property name="hexpand">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkOverlay" id="related_panel">
    <style>
      <class name="fullscreen-player-pane" />
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="related_status">
            <property name="visible">false</property>
            <property name="wrap">true</property>
            <property name="margin-top">12</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="related_retry">
            <property name="label" translatable="yes">Retry</property>
            <property name="halign">center</property>
            <property name="visible">false</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="related_list">
            <property name="orientation">vertical</property>
            <property name="vexpand">true</property>
          </object>
        </child>
      </object>
    </property>
    <child type="overlay">
      <object class="AdwSpinner" id="related_loading">
        <property name="can-target">false</property>
        <property name="visible">false</property>
        <property name="halign">center</property>
        <property name="valign">center</property>
        <property name="width-request">32</property>
        <property name="height-request">32</property>
        <accessibility>
          <property name="label" translatable="yes">Loading related tracks...</property>
        </accessibility>
      </object>
    </child>
  </object>
  <object class="GtkLabel" id="related_empty">
    <property name="label" translatable="yes">No related tracks found</property>
  </object>
  <object class="GtkLabel" id="related_error">
    <property name="label" translatable="yes">Could not load related tracks</property>
  </object>
  <object class="GtkBox" id="hero_content">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">16</property>
                        <property name="width-request">1</property>
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="halign">fill</property>
                        <property name="valign">fill</property>
                        <property name="margin-start">16</property>
                        <property name="margin-end">16</property>
                        <property name="margin-top">16</property>
                        <property name="margin-bottom">16</property>
                        <child>
                          <object class="GtkButton" id="cover_button">
                            <property name="halign">start</property>
                            <property name="valign">center</property>
                            <property name="tooltip-text" translatable="yes">Show artwork</property>
                            <style>
                              <class name="flat" />
                              <class name="detail-cover-button" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow" id="details_scroll">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vscrollbar-policy">never</property>
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <property name="child">
                              <object class="GtkBox" id="details">
                                <property name="orientation">vertical</property>
                                <property name="spacing">5</property>
                                <property name="hexpand">true</property>
                                <property name="width-request">1</property>
                                <property name="halign">fill</property>
                                <property name="valign">center</property>
                                <style>
                                  <class name="fullscreen-player-details" />
                                </style>
                                <child>
                                  <object class="GtkLabel" id="title">
                                    <property name="xalign">0</property>
                                    <property name="justify">left</property>
                                    <property name="wrap">true</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="lines">4</property>
                                    <property name="ellipsize">end</property>
                                    <property name="width-chars">1</property>
                                    <property name="width-request">1</property>
                                    <property name="halign">fill</property>
                                    <style>
                                      <class name="fullscreen-player-title" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="artist">
                                    <property name="xalign">0</property>
                                    <property name="justify">left</property>
                                    <property name="wrap">true</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="lines">2</property>
                                    <property name="ellipsize">end</property>
                                    <property name="width-chars">1</property>
                                    <property name="width-request">1</property>
                                    <property name="halign">fill</property>
                                    <style>
                                      <class name="fullscreen-player-artist" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="album">
                                    <property name="xalign">0</property>
                                    <property name="justify">left</property>
                                    <property name="wrap">true</property>
                                    <property name="wrap-mode">word-char</property>
                                    <property name="lines">2</property>
                                    <property name="ellipsize">end</property>
                                    <property name="width-chars">1</property>
                                    <property name="width-request">1</property>
                                    <property name="halign">fill</property>
                                    <style>
                                      <class name="fullscreen-player-album" />
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkFlowBox" id="meta">
                                    <property name="column-spacing">4</property>
                                    <property name="row-spacing">4</property>
                                    <property name="selection-mode">none</property>
                                    <property name="max-children-per-line">4</property>
                                    <property name="halign">start</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="fullscreen-player-meta-row" />
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
  <object class="GtkBox" id="queue_panel">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style>
      <class name="fullscreen-player-pane" />
      <class name="fullscreen-player-queue-panel" />
    </style>
    <child>
      <object class="GtkOverlay">
        <property name="vexpand">true</property>
        <property name="child">
          <object class="GtkScrolledWindow" id="queue_scroller">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="vexpand">true</property>
            <style>
              <class name="queue-scroller" />
              <class name="sidebar-scroller" />
              <class name="right-panel-scroller" />
            </style>
          </object>
        </property>
        <child type="overlay">
          <object class="AdwSpinner" id="queue_loading">
            <property name="can-target">false</property>
            <property name="visible">false</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="width-request">32</property>
            <property name="height-request">32</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkToggleButton" id="focus_button">
    <property name="focus-on-click">false</property>
    <property name="icon-name">rufin-view-fullscreen-corners-symbolic</property>
    <property name="tooltip-text" translatable="yes">Expand lyrics and visualizer</property>
    <style>
      <class name="icon-button" />
      <class name="flat" />
      <class name="circular" />
      <class name="fullscreen-focus-button" />
    </style>
  </object>
  <object class="GtkBox" id="lyrics_host">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
  </object>
  <object class="GtkBox" id="visualizer_panel">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style>
      <class name="fullscreen-player-visualizer" />
    </style>
  </object>
  <object class="GtkScrolledWindow" id="equalizer_panel">
    <property name="hscrollbar-policy">automatic</property>
    <property name="vscrollbar-policy">automatic</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <property name="min-content-width">0</property>
    <property name="propagate-natural-width">false</property>
    <property name="propagate-natural-height">false</property>
    <style>
      <class name="fullscreen-player-pane" />
      <class name="fullscreen-player-equalizer-scroller" />
    </style>
  </object>
  <object class="GtkLabel" id="focus_expand_label"><property name="label" translatable="yes">Expand lyrics and visualizer</property></object>
  <object class="GtkLabel" id="focus_restore_label"><property name="label" translatable="yes">Restore player layout</property></object>
</interface>
