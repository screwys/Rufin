<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="GtkLabel" id="no_matches">
    <property name="label" translatable="yes">No matching tracks found</property>
  </object>

  <object class="GtkBox" id="mix">
    <property name="orientation">vertical</property>
    <property name="spacing">12</property>
    <property name="margin-top">6</property>
    <property name="margin-bottom">6</property>
    <property name="margin-start">6</property>
    <property name="margin-end">6</property>
    <property name="width-request">340</property>
    <child>
      <object class="GtkLabel">
        <property name="label" translatable="yes">Mix</property>
        <property name="xalign">0</property>
        <property name="margin-start">4</property>
        <style><class name="heading"/></style>
      </object>
    </child>
    <child>
      <object class="AdwToggleGroup" id="unit">
        <property name="homogeneous">true</property>
        <child>
          <object class="AdwToggle">
            <property name="name">tracks</property>
            <property name="label" translatable="yes">Tracks</property>
          </object>
        </child>
        <child>
          <object class="AdwToggle">
            <property name="name">albums</property>
            <property name="label" translatable="yes">Albums</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkGrid">
        <property name="column-homogeneous">true</property>
        <property name="column-spacing">6</property>
        <property name="row-spacing">6</property>
        <child>
          <object class="GtkToggleButton" id="kind_not_played_recently">
            <property name="label" translatable="yes">Not played recently</property>
            <property name="group">kind_all</property>
            <style><class name="mix-kind"/></style>
            <layout><property name="column">0</property><property name="row">0</property><property name="column-span">2</property></layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="kind_all">
            <property name="label" translatable="yes">Random</property>
            <style><class name="mix-kind"/></style>
            <layout><property name="column">0</property><property name="row">1</property></layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="kind_unplayed">
            <property name="label" translatable="yes">Unplayed</property>
            <property name="group">kind_all</property>
            <style><class name="mix-kind"/></style>
            <layout><property name="column">1</property><property name="row">1</property></layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="kind_played">
            <property name="label" translatable="yes">Played</property>
            <property name="group">kind_all</property>
            <style><class name="mix-kind"/></style>
            <layout><property name="column">0</property><property name="row">2</property></layout>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="kind_recently_added">
            <property name="label" translatable="yes">Recently added</property>
            <property name="group">kind_all</property>
            <style><class name="mix-kind"/></style>
            <layout><property name="column">1</property><property name="row">2</property></layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkListBox">
        <property name="selection-mode">none</property>
        <style><class name="boxed-list"/></style>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Genre</property>
            <child type="suffix">
              <object class="GtkDropDown" id="genre">
                <property name="valign">center</property>
                <property name="enable-search">true</property>
                <style><class name="flat"/></style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Years</property>
            <child type="suffix">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkEntry" id="min_year">
                    <property name="width-chars">5</property>
                    <property name="max-width-chars">5</property>
                    <property name="max-length">4</property>
                    <property name="input-purpose">digits</property>
                    <property name="xalign">0.5</property>
                    <property name="placeholder-text" translatable="yes">Any</property>
                    <accessibility><property name="label" translatable="yes">Minimum year</property></accessibility>
                  </object>
                </child>
                <child><object class="GtkLabel"><property name="label">–</property></object></child>
                <child>
                  <object class="GtkEntry" id="max_year">
                    <property name="width-chars">5</property>
                    <property name="max-width-chars">5</property>
                    <property name="max-length">4</property>
                    <property name="input-purpose">digits</property>
                    <property name="xalign">0.5</property>
                    <property name="placeholder-text" translatable="yes">Any</property>
                    <accessibility><property name="label" translatable="yes">Maximum year</property></accessibility>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwSpinRow" id="limit">
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">1</property>
                <property name="upper">500</property>
                <property name="step-increment">1</property>
                <property name="page-increment">10</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">8</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkButton" id="play_next">
            <style>
              <class name="pill-button"/>
              <class name="pill"/>
            </style>
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">rufin-mail-forward-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="play_next_label">
                    <property name="label" translatable="yes">Play Next</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="play_now">
            <style>
              <class name="pill-button"/>
              <class name="pill"/>
              <class name="suggested-action"/>
            </style>
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">rufin-media-playback-start-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="play_now_label">
                    <property name="label" translatable="yes">Play</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="play_later">
            <style>
              <class name="pill-button"/>
              <class name="pill"/>
            </style>
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">rufin-go-last-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="play_later_label">
                    <property name="label" translatable="yes">Play Later</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
