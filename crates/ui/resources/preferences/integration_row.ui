<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <!-- An integration in the list: name, status and whether it is on. -->
  <object class="GtkListBoxRow" id="row">
    <property name="child">
      <object class="GtkBox">
        <property name="spacing">12</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">4</property>
        <property name="margin-end">4</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="valign">center</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkLabel" id="row_name">
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="heading" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="row_status">
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="dim-label" />
                  <class name="caption" />
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="row_active">
            <property name="valign">center</property>
            <property name="visible">false</property>
            <accessibility>
              <property name="label" translatable="yes">Active</property>
            </accessibility>
            <style>
              <class name="integration-active" />
            </style>
          </object>
        </child>
        <child>
          <object class="GtkImage" id="row_chevron">
            <property name="icon-name">rufin-go-next-symbolic</property>
            <property name="visible">false</property>
            <style>
              <class name="dim-label" />
            </style>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
