<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>
  <object class="GtkScrolledWindow" id="page">
    <property name="hscrollbar-policy">never</property>
    <property name="vexpand">true</property>
    <property name="child"><object class="AdwClamp">
      <property name="maximum-size">480</property><property name="tightening-threshold">360</property>
      <property name="margin-start">24</property><property name="margin-end">24</property>
      <property name="margin-top">4</property><property name="margin-bottom">24</property>
      <property name="child"><object class="GtkBox">
        <property name="orientation">vertical</property><property name="spacing">22</property>
        <child><object class="GtkBox">
          <property name="orientation">vertical</property><property name="spacing">10</property>
          <child><object class="GtkImage" id="ready"><property name="visible">false</property><property name="icon-name">rufin-object-select-symbolic</property><property name="pixel-size">32</property><style><class name="success"/></style></object></child>
          <child><object class="GtkLabel" id="title"><property name="label" translatable="yes">While your library loads</property><property name="justify">center</property><property name="wrap">true</property><style><class name="title-1"/></style></object></child>
          <child><object class="GtkProgressBar" id="bar"><property name="halign">center</property><property name="width-request">300</property><property name="margin-top">4</property></object></child>
          <child><object class="GtkLabel" id="status"><property name="justify">center</property><property name="wrap">true</property><style><class name="dim-label"/><class name="caption"/><class name="numeric"/></style></object></child>
        </object></child>
        <child><object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Online Lookups</property>
          <property name="description" translatable="yes">Rufin asks these services about the music you play. All of this can be changed later in Preferences.</property>
          <child><object class="AdwSwitchRow" id="external_metadata">
            <property name="title" translatable="yes">External metadata lookup</property>
            <property name="subtitle" translatable="yes">Artist pictures, covers and tags from MusicBrainz, Last.fm and Wikidata</property>
          </object></child>
          <child><object class="AdwSwitchRow" id="external_lyrics">
            <property name="title" translatable="yes">External lyrics lookup</property>
            <property name="subtitle" translatable="yes">Lyrics from LRCLIB, NetEase, Genius and SimpMusic when a track has none</property>
          </object></child>
          <child><object class="AdwSwitchRow" id="discord_presence">
            <property name="title" translatable="yes">Discord Rich Presence</property>
            <property name="subtitle" translatable="yes">Shows what you are playing on your Discord profile</property>
          </object></child>
          <child><object class="AdwSwitchRow" id="private_mode">
            <property name="title" translatable="yes">Private mode</property>
            <property name="subtitle" translatable="yes">Turns off lookups, scrobbling, play reporting and update checks</property>
          </object></child>
        </object></child>
        <child><object class="GtkButton" id="start"><property name="label" translatable="yes">Start Listening</property><property name="halign">center</property><style><class name="pill"/><class name="suggested-action"/></style></object></child>
      </object></property>
    </object></property>
  </object>
</interface>
