<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <object class="GtkFlowBoxChild" id="tile">
    <style><class name="card"/><class name="activatable"/></style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">10</property><property name="margin-bottom">10</property>
        <property name="margin-start">10</property><property name="margin-end">10</property>
        <child><object class="GtkImage" id="icon"><property name="pixel-size">32</property></object></child>
        <child><object class="GtkLabel" id="label"/></child>
      </object>
    </property>
  </object>
</interface>
