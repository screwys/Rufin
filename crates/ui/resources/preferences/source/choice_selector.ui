<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>
  <object class="GtkScrolledWindow" id="wrapper">
    <property name="hscrollbar-policy">never</property>
    <property name="vexpand">true</property>
    <property name="child"><object class="AdwClamp">
      <property name="maximum-size">640</property><property name="tightening-threshold">360</property>
      <property name="margin-start">24</property><property name="margin-end">24</property>
      <property name="margin-top">4</property><property name="margin-bottom">12</property>
      <property name="child"><object class="GtkBox">
        <property name="orientation">vertical</property><property name="spacing">18</property>
        <child><object class="GtkBox" id="welcome">
          <property name="orientation">vertical</property><property name="spacing">6</property>
          <child><object class="GtkImage" id="app_icon"><property name="pixel-size">76</property><property name="margin-bottom">6</property></object></child>
          <child><object class="GtkLabel"><property name="label" translatable="yes">Welcome to Rufin</property><property name="justify">center</property><property name="wrap">true</property><style><class name="title-1"/></style></object></child>
          <child><object class="GtkLabel"><property name="label" translatable="yes">Choose where your music is. Add more places later in Preferences.</property><property name="justify">center</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
        </object></child>
        <child><object class="GtkLabel" id="title"><property name="label" translatable="yes">Add Source</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="title-1"/></style></object></child>
        <child><object class="AdwPreferencesGroup" id="found">
          <property name="title" translatable="yes">Found</property>
          <property name="header-suffix"><object class="GtkBox">
            <property name="spacing">8</property>
            <child><object class="GtkSpinner" id="searching"/></child>
            <child><object class="GtkLabel" id="found_status"><style><class name="dim-label"/><class name="caption"/></style></object></child>
          </object></property>
        </object></child>
        <child><object class="GtkLabel" id="status"><property name="visible">false</property><property name="wrap">true</property><property name="xalign">0</property><style><class name="error-text"/></style></object></child>
        <child><object class="AdwPreferencesGroup">
          <property name="title" translatable="yes">Add Manually</property>
          <child><object class="GtkFlowBox" id="kinds">
            <property name="selection-mode">none</property>
            <property name="homogeneous">true</property>
            <property name="min-children-per-line">2</property>
            <property name="max-children-per-line">4</property>
            <property name="column-spacing">8</property><property name="row-spacing">8</property>
          </object></child>
        </object></child>
        <child><object class="GtkButton" id="import_backup"><property name="label" translatable="yes">Import Backup</property><property name="halign">center</property><style><class name="flat"/></style></object></child>
      </object></property>
    </object></property>
  </object>
</interface>
