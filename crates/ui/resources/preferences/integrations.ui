<?xml version='1.0' encoding='UTF-8'?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="AdwNavigationView" id="navigation">
    <child>
      <object class="AdwNavigationPage">
        <property name="title" translatable="yes">Integrations</property>
        <property name="child">
          <object class="GtkBox" id="split">
            <child>
              <object class="GtkScrolledWindow" id="list_scroller">
                <property name="hscrollbar-policy">never</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">600</property>
                    <property name="tightening-threshold">400</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">16</property>
                        <property name="margin-top">16</property>
                        <property name="margin-bottom">16</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="scrobbling_title">
                                <property name="label" translatable="yes">Scrobbling</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox" id="scrobbling_list" />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="lookups_title">
                                <property name="label" translatable="yes">Lookups</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox" id="lookups_list" />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="presence_title">
                                <property name="label" translatable="yes">Presence and links</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox" id="presence_list" />
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="folders_title">
                                <property name="label" translatable="yes">Remote folders</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBox" id="folders_list" />
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="split_separator">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="details">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="hhomogeneous">false</property>
                <property name="vhomogeneous">false</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">lastfm</property>
                    <property name="title">Last.fm</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title">Last.fm</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="lastfm_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Scrobbling</property>
                            <child>
                              <object class="AdwSwitchRow" id="lastfm_enabled">
                                <property name="title" translatable="yes">Scrobble plays</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="lastfm_now_playing">
                                <property name="title" translatable="yes">Now playing updates</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Your own API key</property>
                            <property name="description" translatable="yes">Optional. Rufin has its own.</property>
                            <child>
                              <object class="AdwPasswordEntryRow" id="lastfm_api_key">
                                <property name="title" translatable="yes">API key</property>
                                <property name="show-apply-button">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPasswordEntryRow" id="lastfm_api_secret">
                                <property name="title" translatable="yes">Shared secret</property>
                                <property name="show-apply-button">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="lastfm_api_link">
                                <property name="title" translatable="yes">Create API keys</property>
                                <property name="activatable">true</property>
                                <child type="suffix">
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-external-link-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">listenbrainz</property>
                    <property name="title">ListenBrainz</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title">ListenBrainz</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="listenbrainz_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Account</property>
                            <child>
                              <object class="AdwPasswordEntryRow" id="listenbrainz_token">
                                <property name="title" translatable="yes">User token</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="listenbrainz_token_link">
                                <property name="title" translatable="yes">Find your token</property>
                                <property name="activatable">true</property>
                                <child type="suffix">
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-external-link-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Scrobbling</property>
                            <child>
                              <object class="AdwSwitchRow" id="listenbrainz_enabled">
                                <property name="title" translatable="yes">Scrobble plays</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="listenbrainz_now_playing">
                                <property name="title" translatable="yes">Now playing updates</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">librefm</property>
                    <property name="title">Libre.fm</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title">Libre.fm</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="librefm_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Scrobbling</property>
                            <property name="description" translatable="yes">If the page doesn't load, then Libre.fm blocks your IP range/VPN</property>
                            <child>
                              <object class="AdwSwitchRow" id="librefm_enabled">
                                <property name="title" translatable="yes">Scrobble plays</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="librefm_now_playing">
                                <property name="title" translatable="yes">Now playing updates</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">add_server</property>
                    <property name="title" translatable="yes">Add server</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Add server</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="add_server_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="add_protocol_group">
                            <child>
                              <object class="AdwToggleGroup" id="add_protocol">
                                <property name="homogeneous">true</property>
                                <property name="margin-bottom">8</property>
                                <child><object class="AdwToggle"><property name="name">listenbrainz</property><property name="label" translatable="yes">ListenBrainz API</property></object></child>
                                <child><object class="AdwToggle"><property name="name">audioscrobbler</property><property name="label" translatable="yes">Audioscrobbler API</property></object></child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwEntryRow" id="add_name">
                                <property name="title" translatable="yes">Name</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="add_url">
                                <property name="title" translatable="yes">Server URL</property>
                                <property name="input-purpose">url</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPasswordEntryRow" id="add_token">
                                <property name="title" translatable="yes">User token</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="add_username">
                                <property name="title" translatable="yes">Username</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPasswordEntryRow" id="add_password">
                                <property name="title" translatable="yes">Password</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="add_connect">
                                <property name="label" translatable="yes">Connect</property>
                                <property name="halign">end</property>
                                <property name="margin-top">12</property>
                                <style>
                                  <class name="suggested-action" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">metadata</property>
                    <property name="title" translatable="yes">Metadata</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Metadata</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="metadata_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwSwitchRow" id="external_metadata_row">
                                <property name="title" translatable="yes">External metadata lookup</property>
                                <property name="subtitle" translatable="yes">Also album types and tag suggestions</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="cover_providers">
                            <property name="title" translatable="yes">Album covers</property>
                            <property name="description" translatable="yes">Asked in this order.</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="artist_image_providers">
                            <property name="title" translatable="yes">Artist images</property>
                            <property name="description" translatable="yes">Asked in this order.</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">fanart.tv key</property>
                            <property name="description" translatable="yes">Optional. New images show up sooner with your own key.</property>
                            <child>
                              <object class="AdwPasswordEntryRow" id="fanart_key">
                                <property name="title" translatable="yes">Personal API key</property>
                                <property name="show-apply-button">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="fanart_link">
                                <property name="title" translatable="yes">Get a personal key</property>
                                <property name="activatable">true</property>
                                <child type="suffix">
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-external-link-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">lyrics</property>
                    <property name="title" translatable="yes">Lyrics</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Lyrics</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="lyrics_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwSwitchRow" id="external_lyrics_row">
                                <property name="title" translatable="yes">External lyrics lookup</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="prefer_server_row">
                                <property name="title" translatable="yes">Prefer server lyrics</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="lyrics_providers">
                            <property name="title" translatable="yes">Providers</property>
                            <property name="description" translatable="yes">The closest match wins; on a tie, the higher one.</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">discord</property>
                    <property name="title">Discord</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title">Discord</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="discord_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwSwitchRow" id="presence_row">
                                <property name="title" translatable="yes">Discord Rich Presence</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Status</property>
                            <child>
                              <object class="AdwComboRow" id="display_row">
                                <property name="title" translatable="yes">Status display</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="discord_links_row">
                                <property name="title" translatable="yes">Song and artist links</property>
                                <property name="subtitle" translatable="yes">MusicBrainz or Last.fm</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="paused_row">
                                <property name="title" translatable="yes">Show paused status</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="listening_row">
                                <property name="title" translatable="yes">Use listening activity</property>
                                <property name="subtitle" translatable="yes">Set the Discord activity type to Listening</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">links</property>
                    <property name="title" translatable="yes">Page links</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">Page links</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="links_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwSwitchRow" id="external_links_row">
                                <property name="title" translatable="yes">Show external site links</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Services</property>
                            <child>
                              <object class="AdwSwitchRow" id="lastfm_links_row">
                                <property name="title" translatable="yes">Last.fm</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="musicbrainz_links_row">
                                <property name="title" translatable="yes">MusicBrainz</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="server_links_row">
                                <property name="title" translatable="yes">Server</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">webdav</property>
                    <property name="title" translatable="yes">WebDAV / Nextcloud</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">WebDAV / Nextcloud</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="webdav_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="webdav_group">
                            <child>
                              <object class="AdwActionRow" id="add_webdav">
                                <property name="title" translatable="yes">Add WebDAV folder</property>
                                <property name="activatable">true</property>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-list-add-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">smb</property>
                    <property name="title" translatable="yes">SMB / Samba</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <property name="title" translatable="yes">SMB / Samba</property>
                        <child>
                          <object class="AdwPreferencesGroup" id="smb_hero" />
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup" id="smb_group">
                            <child>
                              <object class="AdwActionRow" id="add_smb">
                                <property name="title" translatable="yes">Add SMB folder</property>
                                <property name="activatable">true</property>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">rufin-list-add-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </object>
  <object class="AdwNavigationPage" id="detail_page">
    <property name="title" translatable="yes">Integrations</property>
  </object>
</interface>
