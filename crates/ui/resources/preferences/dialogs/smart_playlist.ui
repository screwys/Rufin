<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="AdwDialog" id="dialog">
    <property name="follows-content-size">true</property>
    <property name="child">
      <object class="AdwToolbarView" id="toolbar">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">false</property>
            <property name="show-end-title-buttons">false</property>
            <child type="start"><object class="GtkButton" id="cancel"><property name="label" translatable="yes">Cancel</property></object></child>
            <child type="end"><object class="GtkButton" id="submit"><style><class name="suggested-action"/></style></object></child>
            <property name="title-widget">
              <object class="AdwWindowTitle" id="title"/>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow" id="scroller">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="propagate-natural-height">true</property>
            <property name="propagate-natural-width">true</property>
            <property name="max-content-width">1000</property>
            <property name="vexpand">true</property>
            <property name="child">
              <object class="GtkBox" id="editor_content">
                <property name="orientation">vertical</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-bottom">18</property>
                <child><object class="GtkBox" id="editor_layout">
                  <property name="spacing">18</property>
                  <child><object class="GtkBox" id="artwork_host">
                    <property name="hexpand">true</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="valign">start</property>
                    <property name="visible">false</property>
                  </object></child>
                  <child>
                    <object class="GtkBox" id="rules_column">
                      <property name="hexpand">true</property>
                      <property name="orientation">vertical</property>
                      <property name="spacing">20</property>
                      <property name="margin-top">4</property>
                      <property name="margin-start">4</property>
                      <property name="margin-end">4</property>
                      <child><object class="GtkEntry" id="name_entry"><property name="placeholder-text" translatable="yes">Playlist name</property></object></child>
                      <child>
                        <object class="GtkBox" id="templates">
                          <property name="orientation">vertical</property>
                          <property name="spacing">8</property>
                          <property name="visible">false</property>
                          <child>
                            <object class="GtkLabel">
                              <property name="label" translatable="yes">Start from</property>
                              <property name="xalign">0</property>
                              <style><class name="dim-label"/></style>
                            </object>
                          </child>
                          <child>
                            <object class="AdwWrapBox" id="template_chips">
                              <property name="child-spacing">6</property>
                              <property name="line-spacing">6</property>
                            </object>
                          </child>
                        </object>
                      </child>
                      <child>
                        <object class="GtkBox">
                          <property name="orientation">vertical</property>
                          <property name="spacing">8</property>
                          <child>
                            <object class="GtkBox">
                              <property name="spacing">8</property>
                              <child><object class="GtkLabel"><property name="label" translatable="yes">Match</property><style><class name="heading"/></style></object></child>
                              <child><object class="GtkDropDown" id="matching"><property name="valign">center</property></object></child>
                              <child><object class="GtkLabel"><property name="label" translatable="yes">of these rules</property><property name="xalign">0</property><property name="hexpand">true</property><property name="wrap">true</property><style><class name="heading"/></style></object></child>
                            </object>
                          </child>
                          <child>
                            <object class="GtkBox" id="conditions_host">
                              <property name="orientation">vertical</property>
                              <child>
                                <object class="GtkListBox" id="conditions">
                                  <property name="selection-mode">none</property>
                                  <property name="hexpand">true</property>
                                  <style><class name="boxed-list"/></style>
                                </object>
                              </child>
                            </object>
                          </child>
                          <child>
                            <object class="GtkBox">
                              <property name="spacing">4</property>
                              <child>
                                <object class="GtkButton" id="add_rule">
                                  <style><class name="flat"/></style>
                                  <property name="child"><object class="AdwButtonContent"><property name="icon-name">rufin-list-add-symbolic</property><property name="label" translatable="yes">Add rule</property></object></property>
                                </object>
                              </child>
                              <child>
                                <object class="GtkButton" id="add_group">
                                  <style><class name="flat"/></style>
                                  <property name="child"><object class="AdwButtonContent"><property name="icon-name">rufin-list-add-symbolic</property><property name="label" translatable="yes">Add group</property></object></property>
                                </object>
                              </child>
                            </object>
                          </child>
                        </object>
                      </child>
                      <child>
                        <object class="GtkBox">
                          <property name="orientation">vertical</property>
                          <property name="spacing">8</property>
                          <child>
                            <object class="GtkLabel">
                              <property name="label" translatable="yes">Order</property>
                              <property name="xalign">0</property>
                              <style><class name="heading"/></style>
                            </object>
                          </child>
                          <child>
                            <object class="GtkListBox">
                              <property name="selection-mode">none</property>
                              <style><class name="boxed-list"/></style>
                              <child>
                                <object class="AdwActionRow">
                                  <property name="title" translatable="yes">Sort by</property>
                                  <property name="activatable">false</property>
                                  <child type="suffix"><object class="GtkDropDown" id="sort"><property name="valign">center</property></object></child>
                                  <child type="suffix">
                                    <object class="GtkButton" id="direction">
                                      <property name="valign">center</property>
                                      <property name="tooltip-text" translatable="yes">Change sort order</property>
                                    </object>
                                  </child>
                                </object>
                              </child>
                              <child>
                                <object class="AdwActionRow">
                                  <property name="title" translatable="yes">Limit</property>
                                  <property name="activatable">false</property>
                                  <child type="suffix">
                                    <object class="GtkEntry" id="limit">
                                      <property name="valign">center</property>
                                      <property name="placeholder-text" translatable="yes">No limit</property>
                                      <property name="width-chars">8</property>
                                      <property name="max-width-chars">8</property>
                                    </object>
                                  </child>
                                </object>
                              </child>
                              <child>
                                <object class="AdwActionRow" id="period_row">
                                  <property name="title" translatable="yes">Plays from</property>
                                  <property name="activatable">false</property>
                                  <property name="visible">false</property>
                                  <child type="suffix"><object class="GtkDropDown" id="activity_period"><property name="valign">center</property></object></child>
                                </object>
                              </child>
                              <child>
                                <object class="AdwActionRow" id="source_row">
                                  <property name="title" translatable="yes">Source</property>
                                  <property name="activatable">false</property>
                                  <property name="visible">false</property>
                                  <child type="suffix"><object class="GtkDropDown" id="source"><property name="valign">center</property></object></child>
                                </object>
                              </child>
                            </object>
                          </child>
                        </object>
                      </child>
                    </object>
                  </child>
                </object></child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
