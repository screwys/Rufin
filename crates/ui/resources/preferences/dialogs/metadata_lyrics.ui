<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>
  <object class="GtkPaned" id="lyrics_content">
    <property name="orientation">vertical</property><property name="vexpand">true</property>
    <property name="resize-start-child">true</property><property name="resize-end-child">true</property>
    <property name="shrink-start-child">false</property><property name="shrink-end-child">false</property>
    <property name="start-child"><object class="GtkBox">
      <property name="orientation">vertical</property><property name="spacing">8</property><property name="margin-bottom">12</property>
      <child><object class="GtkEntry" id="artist"><property name="placeholder-text" translatable="yes">Artist</property><property name="width-chars">1</property><property name="hexpand">true</property><property name="secondary-icon-name">rufin-edit-clear-symbolic</property><property name="secondary-icon-tooltip-text" translatable="yes">Clear artist</property><property name="secondary-icon-activatable">true</property></object></child>
      <child><object class="GtkEntry" id="title"><property name="placeholder-text" translatable="yes">Song</property><property name="width-chars">1</property><property name="hexpand">true</property><property name="secondary-icon-name">rufin-edit-clear-symbolic</property><property name="secondary-icon-tooltip-text" translatable="yes">Clear title</property><property name="secondary-icon-activatable">true</property></object></child>
      <child><object class="GtkLabel" id="status"><property name="visible">false</property><property name="xalign">0</property><property name="wrap">true</property></object></child>
      <child><object class="GtkScrolledWindow"><property name="vexpand">true</property><property name="min-content-height">180</property><property name="hscrollbar-policy">never</property><property name="child"><object class="GtkListBox" id="results"><property name="selection-mode">single</property><style><class name="boxed-list-separate"/></style></object></property></object></child>
      <child><object class="GtkBox" id="storage"><property name="visible">false</property><property name="homogeneous">true</property><style><class name="linked"/></style>
        <child><object class="GtkToggleButton" id="sidecar"><property name="label" translatable="yes">Save in folder</property></object></child>
        <child><object class="GtkToggleButton" id="embed"><property name="label" translatable="yes">Embed in track</property><property name="group">sidecar</property></object></child>
      </object></child>
    </object></property>
    <property name="end-child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin-top">12</property><property name="height-request">240</property>
      <child><object class="GtkRevealer" id="editor_revealer"><property name="transition-type">crossfade</property><property name="transition-duration">160</property><property name="vexpand">true</property><property name="child"><object class="GtkBox" id="editor_host"><property name="orientation">vertical</property><property name="vexpand">true</property></object></property></object></child>
    </object></property>
  </object>
</interface>
