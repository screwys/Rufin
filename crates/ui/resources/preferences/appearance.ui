<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="GtkBox" id="appearance_page">
    <property name="orientation">vertical</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">600</property>
        <property name="tightening-threshold">400</property>
        <property name="margin-top">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="child">
          <object class="AdwInlineViewSwitcher">
            <property name="stack">tabs</property>
            <property name="homogeneous">true</property>
            <property name="hexpand">true</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="AdwViewStack" id="tabs">
        <property name="vexpand">true</property>
        <child>
          <object class="AdwViewStackPage">
            <property name="name">layout</property>
            <property name="title" translatable="yes">Layout</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Accessibility</property>
                    <child>
                      <object class="AdwSwitchRow" id="reduce_motion">
                        <property name="title" translatable="yes">Reduce motion</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Window</property>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Left sidebar</property>
                        <child type="suffix">
                          <object class="AdwToggleGroup" id="default_left">
                            <property name="valign">center</property>
                            <property name="can-shrink">true</property>
                            <child><object class="AdwToggle"><property name="name">full</property><property name="label" translatable="yes">Full</property></object></child>
                            <child><object class="AdwToggle"><property name="name">compact</property><property name="label" translatable="yes">Compact</property></object></child>
                            <child><object class="AdwToggle"><property name="name">hidden</property><property name="label" translatable="yes">Hidden</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Right sidebar</property>
                        <child type="suffix">
                          <object class="AdwToggleGroup" id="default_right">
                            <property name="valign">center</property>
                            <property name="can-shrink">true</property>
                            <child><object class="AdwToggle"><property name="name">visible</property><property name="label" translatable="yes">Visible</property></object></child>
                            <child><object class="AdwToggle"><property name="name">hidden</property><property name="label" translatable="yes">Hidden</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Narrow window</property>
                    <child>
                      <object class="AdwSwitchRow" id="narrow_row">
                        <property name="title" translatable="yes">Use different layout below a threshold width</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="threshold_row">
                        <property name="title" translatable="yes">Narrow layout threshold</property>
                        <property name="digits">0</property>
                        <property name="numeric">true</property>
                        <child type="suffix">
                          <object class="GtkLabel">
                            <property name="label">px</property>
                            <style>
                              <class name="dim-label" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="narrow_left_row">
                        <property name="title" translatable="yes">Left sidebar</property>
                        <child type="suffix">
                          <object class="AdwToggleGroup" id="narrow_left">
                            <property name="valign">center</property>
                            <property name="can-shrink">true</property>
                            <child><object class="AdwToggle"><property name="name">full</property><property name="label" translatable="yes">Full</property></object></child>
                            <child><object class="AdwToggle"><property name="name">compact</property><property name="label" translatable="yes">Compact</property></object></child>
                            <child><object class="AdwToggle"><property name="name">hidden</property><property name="label" translatable="yes">Hidden</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="narrow_right_row">
                        <property name="title" translatable="yes">Right sidebar</property>
                        <child type="suffix">
                          <object class="AdwToggleGroup" id="narrow_right">
                            <property name="valign">center</property>
                            <property name="can-shrink">true</property>
                            <child><object class="AdwToggle"><property name="name">visible</property><property name="label" translatable="yes">Visible</property></object></child>
                            <child><object class="AdwToggle"><property name="name">hidden</property><property name="label" translatable="yes">Hidden</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Grids</property>
                    <child>
                      <object class="AdwSwitchRow" id="grid_favorite_badges_row">
                        <property name="title" translatable="yes">Show a badge for favorited items</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="grid_star_ratings_row">
                        <property name="title" translatable="yes">Show star ratings</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="sidebar_group">
                    <property name="title" translatable="yes">Sidebar items</property>
                    <child>
                      <object class="AdwSwitchRow" id="saved_row">
                        <property name="title" translatable="yes">Saved</property>
                        <property name="subtitle" translatable="yes">Fixed position</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwViewStackPage">
            <property name="name">home</property>
            <property name="title" translatable="yes">Home</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Display</property>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Size</property>
                        <child type="suffix">
                          <object class="AdwToggleGroup" id="home_size">
                            <property name="valign">center</property>
                            <property name="can-shrink">true</property>
                            <child><object class="AdwToggle"><property name="label" translatable="yes">Compact</property></object></child>
                            <child><object class="AdwToggle"><property name="label" translatable="yes">Default</property></object></child>
                            <child><object class="AdwToggle"><property name="label" translatable="yes">Large</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Spacing</property>
                        <child type="suffix">
                          <object class="AdwToggleGroup" id="home_spacing">
                            <property name="valign">center</property>
                            <property name="can-shrink">true</property>
                            <child><object class="AdwToggle"><property name="label" translatable="yes">Small</property></object></child>
                            <child><object class="AdwToggle"><property name="label" translatable="yes">Default</property></object></child>
                            <child><object class="AdwToggle"><property name="label" translatable="yes">Wide</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Blocks</property>
                    <child>
                      <object class="GtkListBox" id="home_blocks">
                        <property name="selection-mode">none</property>
                        <style>
                          <class name="boxed-list" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <!-- Quick mix's entries in their Home order, then the templates, then the user's smart playlists. -->
                  <object class="AdwPreferencesGroup" id="quick_mix_group">
                    <property name="title" translatable="yes">Mixes</property>
                    <property name="visible">false</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <style><class name="card"/></style>
                        <child>
                          <object class="AdwWrapBox" id="quick_mix_choices">
                            <property name="child-spacing">8</property>
                            <property name="line-spacing">8</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="quick_mix_playlists_part">
                            <property name="orientation">vertical</property>
                            <property name="visible">false</property>
                            <child>
                              <object class="GtkSeparator" />
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Smart playlists</property>
                                <property name="xalign">0</property>
                                <property name="margin-top">12</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <style><class name="quick-mix-heading"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="AdwWrapBox" id="quick_mix_playlists">
                                <property name="child-spacing">8</property>
                                <property name="line-spacing">8</property>
                                <property name="margin-top">8</property>
                                <property name="margin-bottom">12</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwViewStackPage">
            <property name="name">player</property>
            <property name="title" translatable="yes">Player</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Bottom bar</property>
                    <child>
                      <object class="AdwSwitchRow" id="bottom_bar_rating_row">
                        <property name="title" translatable="yes">Show ratings in the bottom bar</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="waveform_row">
                        <property name="title" translatable="yes">Waveform seekbar</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Right sidebar</property>
                    <child>
                      <object class="AdwSwitchRow" id="lyrics_panel_row">
                        <property name="title" translatable="yes">Show lyrics</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="visualizer_panel_row">
                        <property name="title" translatable="yes">Show visualizer</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="combine_panels_row">
                        <property name="title" translatable="yes">Combine lyrics and visualizer</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Fullscreen player</property>
                    <child>
                      <object class="AdwSwitchRow" id="fullscreen_lyrics">
                        <property name="title" translatable="yes">Show lyrics</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="fullscreen_visualizer">
                        <property name="title" translatable="yes">Show visualizer</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="dynamic_background">
                        <property name="title" translatable="yes">Dynamic background</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="background_image">
                        <property name="title" translatable="yes">Enable background image</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwViewStackPage">
            <property name="name">menus</property>
            <property name="title" translatable="yes">Menus</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup" id="menu_group">
                    <property name="title" translatable="yes">Item menus</property>
                    <property name="description" translatable="yes">Select an entry to show or hide it.</property>
                    <child>
                      <object class="GtkBox" id="menu_preview">
                        <property name="orientation">vertical</property>
                        <property name="halign">center</property>
                        <property name="width-request">260</property>
                        <property name="margin-top">8</property>
                        <style>
                          <class name="card" />
                          <class name="menu-preview" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
