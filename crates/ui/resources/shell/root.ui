<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="GtkStack" id="root_stack">
    <property name="hhomogeneous">false</property>
    <property name="vhomogeneous">false</property>
    <property name="interpolate-size">false</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <style><class name="app-root"/></style>
    <child>
      <object class="GtkStackPage">
        <property name="name">app</property>
        <property name="child">
          <object class="GtkOverlay" id="app_root_overlay">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="child">
              <object class="GtkBox" id="app_root">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <style><class name="app-root"/></style>
                <child>
                  <object class="AdwBanner" id="temporary_storage_banner">
                    <property name="title" translatable="yes">Temporary library storage is in use. Changes may be lost when Rufin closes.</property>
                    <property name="revealed">false</property>
                  </object>
                </child>
                <child>
                  <object class="AdwBanner" id="fresh_start_banner">
                    <property name="title" translatable="yes">Rufin started with fresh user state because the saved database could not be used. Your settings and saved logins are unchanged.</property>
                    <property name="button-label" translatable="yes">Import Backup</property>
                    <property name="revealed">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkOverlay" id="app_content_overlay">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <property name="child">
                      <object class="GtkStack" id="app_content_stack">
                        <property name="hhomogeneous">false</property>
                        <property name="vhomogeneous">false</property>
                        <property name="interpolate-size">false</property>
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <style><class name="app-content-stack"/></style>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">main</property>
                            <property name="child">
                              <object class="GtkBox" id="upper">
                                <property name="orientation">horizontal</property>
                                <property name="hexpand">true</property>
                                <property name="vexpand">true</property>
                                <child>
                                  <object class="GtkOverlay" id="shell_layout">
                                    <property name="hexpand">true</property>
                                    <property name="vexpand">true</property>
                                    <property name="child">
                                      <object class="AdwOverlaySplitView" id="split_view">
                                        <property name="hexpand">true</property>
                                        <property name="vexpand">true</property>
                                        <property name="enable-hide-gesture">false</property>
                                        <property name="enable-show-gesture">false</property>
                                        <property name="sidebar-width-unit">px</property>
                                        <property name="content">
                                          <object class="GtkBox" id="content_row">
                                            <property name="orientation">horizontal</property>
                                            <property name="hexpand">true</property>
                                            <property name="vexpand">true</property>
                                          </object>
                                        </property>
                                      </object>
                                    </property>
                                    <child type="overlay">
                                      <object class="GtkBox" id="left_resize_handle">
                                        <property name="orientation">vertical</property>
                                        <property name="width-request">8</property>
                                        <property name="halign">start</property>
                                        <property name="valign">fill</property>
                                        <property name="vexpand">true</property>
                                        <property name="focusable">false</property>
                                        <accessibility><property name="label" translatable="yes">Hold and drag to resize</property></accessibility>
                                        <style><class name="sidebar-resize-handle"/></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
            <child type="overlay">
              <object class="GtkLabel" id="control_feedback_label">
                <property name="halign">center</property>
                <property name="valign">end</property>
                <property name="visible">false</property>
                <style><class name="control-feedback-toast"/></style>
              </object>
            </child>
            <child type="overlay">
              <object class="GtkBox" id="source_refresh_feedback">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="halign">center</property>
                <property name="valign">end</property>
                <property name="visible">false</property>
                <property name="can-target">false</property>
                <style><class name="source-refresh-feedback"/></style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">rufin-view-refresh-symbolic</property>
                    <property name="pixel-size">16</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel" id="source_refresh_feedback_label">
                        <property name="xalign">0</property>
                        <property name="max-width-chars">36</property>
                        <property name="ellipsize">end</property>
                        <property name="single-line-mode">true</property>
                        <style><class name="caption-heading"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkProgressBar" id="source_refresh_feedback_progress">
                        <property name="width-request">250</property>
                        <style><class name="source-refresh-progress"/></style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="overlay">
              <object class="GtkBox" id="operation_feedback">
                <property name="orientation">horizontal</property>
                <property name="spacing">10</property>
                <property name="halign">center</property>
                <property name="valign">end</property>
                <property name="visible">false</property>
                <property name="focusable">true</property>
                <style><class name="operation-feedback"/></style>
                <child>
                  <object class="GtkBox" id="operation_feedback_artwork">
                    <property name="orientation">horizontal</property>
                    <property name="width-request">48</property>
                    <property name="height-request">48</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="valign">center</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkLabel" id="operation_feedback_title">
                        <property name="xalign">0</property>
                        <property name="max-width-chars">34</property>
                        <property name="ellipsize">end</property>
                        <property name="single-line-mode">true</property>
                        <style><class name="heading"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="operation_feedback_subtitle">
                        <property name="xalign">0</property>
                        <property name="max-width-chars">34</property>
                        <property name="ellipsize">end</property>
                        <property name="single-line-mode">true</property>
                        <style><class name="dim-label"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="operation_feedback_action">
                    <property name="label" translatable="yes">Undo</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                    <style><class name="flat"/></style>
                  </object>
                </child>
              </object>
            </child>
            <child type="overlay">
              <object class="GtkBox" id="startup_loading_host">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="visible">false</property>
                <style><class name="startup-loading-root"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <style><class name="loading-page"/></style>
                    <child><object class="AdwSpinner"/></child>
                    <child>
                      <object class="GtkLabel" id="startup_loading_status">
                        <property name="wrap">true</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="startup-loading-status"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
