<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <object class="GtkBox" id="header">
    <property name="spacing">10</property>
    <property name="margin-top">6</property><property name="margin-bottom">6</property>
    <property name="margin-start">6</property><property name="margin-end">6</property>
    <child><object class="GtkBox" id="cover"><property name="valign">center</property></object></child>
    <child><object class="GtkBox">
      <property name="orientation">vertical</property><property name="spacing">3</property>
      <property name="valign">center</property><property name="hexpand">true</property>
      <child><object class="GtkBox" id="title_host"><property name="hexpand">true</property><style><class name="heading"/></style></object></child>
      <child><object class="GtkBox" id="subtitle_host"><property name="hexpand">true</property><style><class name="dim-label"/><class name="caption"/></style></object></child>
    </object></child>
    <child><object class="GtkButton" id="favorite"><property name="valign">center</property><property name="tooltip-text" translatable="yes">Favorite</property><style><class name="flat"/><class name="circular"/><class name="favorite-toggle"/></style></object></child>
    <child><object class="GtkButton" id="details"><property name="valign">center</property><property name="icon-name">rufin-go-next-symbolic</property><property name="tooltip-text" translatable="yes">Details</property><style><class name="flat"/><class name="circular"/></style></object></child>
  </object>
</interface>
