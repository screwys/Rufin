<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>

  <template class="RufinLibraryToolbarView" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">12</property>
    <property name="hexpand">true</property>
    <property name="halign">fill</property>
    <property name="width-request">1</property>
    <style>
      <class name="track-toolbar"/>
    </style>
    <child>
      <object class="GtkBox" id="search_host">
        <property name="hexpand">true</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="end_area">
        <child>
          <object class="GtkBox" id="controls">
            <property name="spacing">12</property>
            <child>
              <object class="GtkButton" id="command_button">
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="import_button">
                <property name="visible">false</property>
                <property name="icon-name">rufin-document-open-symbolic</property>
                <property name="tooltip-text" translatable="yes">Import Playlist</property>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="sort_dropdown">
                <property name="halign">end</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="direction">
                <style>
                  <class name="library-toolbar-icon-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="layout">
                <style>
                  <class name="library-toolbar-icon-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="configure">
                <property name="icon-name">rufin-more-symbolic</property>
                <style>
                  <class name="library-toolbar-icon-button"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="reservation_host"/>
        </child>
      </object>
    </child>
  </template>
</interface>
