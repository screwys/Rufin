<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <object class="GtkBox" id="metric"><property name="orientation">vertical</property><property name="spacing">4</property>
    <child><object class="GtkLabel" id="value"><property name="wrap">true</property><property name="wrap-mode">word-char</property><property name="width-chars">1</property><style><class name="heading"/></style></object></child>
    <child><object class="GtkLabel" id="label"><property name="wrap">true</property><property name="wrap-mode">word-char</property><property name="width-chars">1</property><style><class name="caption"/><class name="dim-label"/></style></object></child>
  </object>
</interface>
