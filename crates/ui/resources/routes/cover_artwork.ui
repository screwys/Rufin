<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20"/>
  <object class="GtkButton" id="edit_artwork">
    <property name="visible">false</property>
    <property name="halign">end</property>
    <property name="valign">end</property>
    <property name="icon-name">rufin-camera-photo-symbolic</property>
    <property name="tooltip-text" translatable="yes">Artwork</property>
    <property name="focus-on-click">false</property>
    <style><class name="cover-artwork-button"/><class name="cover-glass"/><class name="circular"/></style>
  </object>
</interface>
